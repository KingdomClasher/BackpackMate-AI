else
  export NODE_PATH="/mnt/d/Georgia Tech/HackGT/backpackmate-mastra/backpackmate/node_modules/jsondiffpatch/bin/node_modules:/mnt/d/Georgia Tech/HackGT/backpackmate-mastra/backpackmate/node_modules/jsondiffpatch/node_modules:/mnt/d/Georgia Tech/HackGT/backpackmate-mastra/backpackmate/node_modules:/mnt/d/Georgia Tech/HackGT/backpackmate-mastra/node_modules:/mnt/d/Georgia Tech/HackGT/node_modules:/mnt/d/Georgia Tech/node_modules:/mnt/d/node_modules:/mnt/d/Georgia Tech/HackGT/backpackmate-mastra/backpackmate/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../jsondiffpatch/bin/jsondiffpatch.js" "$@"
